SKELLY_NAME=USA
SKELLY_SIMULATION=true
# Developer-only packet probes stay unavailable on public images.
SKELLY_DEVELOPER_MODE=false
SKELLY_ONBOARDING_REQUIRED=false
# Optional HTTPS JSON manifest used by the Setup tab's update checker.
SKELLY_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/TheDadTech/UltraSkellyAdvanced/main/releases/stable/latest.json
# Set false and provide the address discovered by bluetoothctl for real hardware.
# SKELLY_BLE_ADDRESS=AA:BB:CC:DD:EE:01
SKELLY_BLE_NAME=Animated Skelly
# Optional: leave blank to discover either known Skelly(Live) speaker name.
# SKELLY_CLASSIC_AUDIO_ADDRESS=AA:BB:CC:DD:EE:02
SKELLY_CLASSIC_AUDIO_NAME=Skelly(Live)
SKELLY_CLASSIC_AUDIO_PIN=0727
# Safe image default. Advanced users replace this with their ESP32/DAC address.
# Loopback prevents a fresh installation from transmitting to another device.
SKELLY_DAC_TARGET_IP=127.0.0.1
SKELLY_DAC_TARGET_PORT=5568
SKELLY_DAC_UNIVERSE=1
SKELLY_DAC_PRIORITY=90
SKELLY_DAC_FPS=20
SKELLY_DAC_JAW_CHANNEL=1
SKELLY_DAC_TILT_CHANNEL=5
SKELLY_DAC_YAW_CHANNEL=7
SKELLY_DAC_PITCH_CHANNEL=12
SKELLY_DAC_JAW_CLOSED=0
SKELLY_DAC_TILT_CENTER=127
SKELLY_DAC_YAW_CENTER=127
SKELLY_DAC_PITCH_CENTER=127
SKELLY_PROP_MODEL=ultra_skelly
SKELLY_PORT=8787
SKELLY_CAMERA_DEVICE=/dev/video0
SKELLY_MICROPHONE_DEVICE=auto
SKELLY_VOICE_THRESHOLD_DBFS=-38
SKELLY_SPEECH_MODEL_PATH=/var/lib/skelly-ai/models/vosk-model-small-en-us-0.15
SKELLY_PERCEPTION_CAMERA_INTERVAL_SECONDS=2.5
SKELLY_PERCEPTION_PRESENCE_CONFIRMATIONS=2
SKELLY_PERCEPTION_CLEAR_CONFIRMATIONS=4
SKELLY_PERCEPTION_RECORD_SECONDS=5
SKELLY_PERCEPTION_DEPARTURE_MOTION_THRESHOLD=1.0
SKELLY_BRAIN_URL=http://127.0.0.1:8790
SKELLY_BRAIN_MODEL=skelly-local
SKELLY_BRAIN_TIMEOUT_SECONDS=90
SKELLY_LOCAL_SPEECH_VOICE=en-us+m3
SKELLY_LOCAL_SPEECH_SPEED=145
SKELLY_LOCAL_SPEECH_PITCH=30
SKELLY_LOCAL_SPEECH_WORD_GAP=5
# Jaw-envelope timing relative to playback. This does not protect the first word.
SKELLY_LOCAL_SPEECH_BLUETOOTH_DELAY_SECONDS=0.2
# Very quiet audio sent before speech so Bluetooth is active before word one.
SKELLY_LOCAL_SPEECH_SPEAKER_PREROLL_SECONDS=0.65

# Add these later through the local setup page. Do not commit real values.
# SKELLY_GROQ_API_KEY=
# SKELLY_ELEVENLABS_API_KEY=
# SKELLY_FPP_TOKEN=
