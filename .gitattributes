# Default text handling
* text=auto

# Linux / Raspberry Pi scripts and configuration
*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf

# Source and web files
*.py      text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf

# Windows-specific scripts
*.ps1     text eol=crlf

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary